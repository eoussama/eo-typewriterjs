{
  "name": "eo-typewriterjs",
  "type": "module",
  "version": "6.0.1",
  "packageManager": "pnpm@12.15.0",
  "description": "JavaScript utility for advanced typewriter-like animations.",
  "author": "EOussama",
  "license": "MIT",
  "funding": "https://github.com/sponsors/eoussama",
  "homepage": "https://eo-typewriterjs.ouss.es",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoussama/eo-typewriterjs.git"
  },
  "bugs": {
    "url": "https://github.com/eoussama/eo-typewriterjs/issues"
  },
  "keywords": [
    "animation",
    "typewriter",
    "js",
    "library",
    "utility"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./audio-pack": {
      "import": {
        "types": "./dist/audio-pack.d.mts",
        "default": "./dist/audio-pack.mjs"
      },
      "require": {
        "types": "./dist/audio-pack.d.cts",
        "default": "./dist/audio-pack.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "dx lint",
    "lint:fix": "dx fix",
    "test": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "pnpm audit && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:smoke && pnpm docs:build && playwright install chromium && pnpm test:e2e && pnpm test:mutation",
    "prepack": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@eoussama/core": "^0.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eoussama/dx": "^0.1.3",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
